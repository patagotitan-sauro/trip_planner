# Copy to .env and edit. Never commit .env or put real secrets here.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_PORT=8085
# 127.0.0.1 = only this computer. Use this machine's LAN IP to allow your private network.
APP_BIND=127.0.0.1